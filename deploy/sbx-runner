#!/bin/bash
# ares-sbx-runner — the sole sudo entry point from the `ares` daemon to the
# `ares-sbx` sandbox user. Takes exactly one argument: the command string.
# Scrubs the environment unconditionally so the daemon's secret env can never
# reach a sandbox shell, regardless of sudoers configuration.
set -eu

[ "$#" -eq 1 ] || { echo "usage: ares-sbx-runner <command>" >&2; exit 64; }

cd /home/ares-sbx || exit 65

# Hard backstops; the daemon also enforces its own timeout and kills the group.
#
# RLIMIT_NPROC (ulimit -u) counts every task owned by this uid *system-wide*,
# threads included — not just this shell's descendants. One headless Chromium
# is ~100-150 tasks, so the old value of 256 wedged the entire sandbox user as
# soon as two fetches overlapped or one crashed run leaked its children: every
# later command died with `fork: Resource temporarily unavailable`, including
# /etc/profile, until the VM restarted. 1024 leaves room for a few concurrent
# browsers while still bounding a fork bomb.
ulimit -t 300      # CPU seconds
ulimit -f 1048576  # max file size (blocks)
ulimit -u 1024     # max processes AND threads, per uid, system-wide

exec /usr/bin/env -i \
  PATH=/usr/local/bin:/usr/bin:/bin \
  HOME=/home/ares-sbx \
  LANG=C.UTF-8 \
  SHELL=/bin/bash \
  /bin/bash -lc "$1"
