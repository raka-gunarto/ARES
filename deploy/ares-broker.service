[Unit]
Description=ARES root broker (executes human-approved, allowlisted privilege requests)
After=network-online.target

[Service]
Type=simple
# Runs as root by design (§14.1): it is the ONLY component that executes
# privileged actions, and only ones that are both human-approved AND
# allowlist-regex-matched. Stdlib-only, so it uses the SYSTEM python3, never
# the ARES venv — it must not share ARES's third-party dependency surface.
User=root
ExecStart=/usr/bin/python3 /opt/ares/app/broker/aresbrokerd.py /etc/ares/broker.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
